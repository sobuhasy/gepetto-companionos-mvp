
# Companion voice runtime controls
TYPECAST_MODEL="ssfm-v30"
TYPECAST_MAX_CHARS="900"
TYPECAST_EMOTION_TYPE="smart"
COMPANION_VOICE_ID="your_typecast_voice_id"
COMPANION_VOICE_ENABLED="true"
ENABLE_LOCAL_TTS_FALLBACK="false"

# Native browser avatar: VTube Studio is optional and is not contacted in native mode.
# Other backends: native-pico, vtube, pico, hybrid.
ROBOT_BODY_BACKEND="native"
# Only authorized local model assets belong here; never commit private models.
LIVE2D_MODELS_DIR="data/live2d/models"
# Optional fallback; dashboard profile settings override this local URL.
LIVE2D_MODEL_URL=""
